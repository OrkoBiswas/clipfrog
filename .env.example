# Local development only. Replace passwords before exposing any service.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://clipforge:clipforge_local@127.0.0.1:55432/clipforge
POSTGRES_PASSWORD=clipforge_local
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clipforge
S3_ACCESS_KEY_ID=clipforge_local
S3_SECRET_ACCESS_KEY=clipforge_local_password
S3_FORCE_PATH_STYLE=true
COOKIE_SECURE=false
SESSION_DAYS=14
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=hello@clipforge.local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional JSON; must sum to 100. Cloud ranking also requires per-project opt-in.
HIGHLIGHT_WEIGHTS={"hook":25,"completeness":20,"insight":20,"emphasis":10,"visual":10,"novelty":10,"boundaries":5}
WORKER_DEVICE=cpu
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=5368709120
MAX_SOURCE_DURATION_MINUTES=120
DEFAULT_CLIP_LIMIT=100
# Disabled by default. Positive values delete idle projects and media after this many inactive days.
MEDIA_RETENTION_DAYS=0
